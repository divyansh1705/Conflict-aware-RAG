runs/*/cache/
runs/*.log
# downloaded model weights, if a local HF cache is ever pointed inside the repo
.hf_cache/
models/

# --- LaTeX build by-products (report.pdf itself is committed) ---
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
